# Copiar como .env en el servidor (el .env nunca se sube a git).

# Acceso al panel /jeyadmin. La contraseña se guarda encriptada (BCrypt) en la base de datos.
# Cambiar cualquiera de los dos y reiniciar el contenedor actualiza el acceso.
ADMIN_EMAIL=correo@ejemplo.com
ADMIN_PASSWORD=cambia-esta-contrasena

# true cuando el sitio se sirve por https (producción)
COOKIE_SEGURA=true

# Puerto local del VPS al que apunta el proxy (nginx)
PUERTO=8090
